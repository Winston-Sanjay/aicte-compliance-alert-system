# ============================================================
# AICTE Approval & Compliance System - Backend Environment Config
# ============================================================

# PostgreSQL Database Configuration
PGUSER=postgres
PGHOST=localhost
PGPASSWORD=your_postgres_password
PGDATABASE=aicte_db
PGPORT=5432

# Application Ports
FRONTEND_PORT=3000
BACKEND_PORT=5000
PORT=5000

# Secure Secret Key for JWT Signing
TOKEN_KEY=aicte_sih_hackathon_2026_secret_key_change_in_production

# Prisma Connection URL (auto-assembled from individual PG variables or provided directly)
DATABASE_URL="postgresql://postgres:your_postgres_password@localhost:5432/aicte_db?schema=public"

NODE_ENV=development
UPLOAD_DIR=./uploads
OCR_SERVICE_URL=http://localhost:8000
